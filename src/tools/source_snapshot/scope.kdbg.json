{
  "schema": "kdbg.source-scope.v1",
  "scope_version": "kdbg.product-source.v1",
  "include": [
    ".env.example",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY.lock.json",
    ".github/workflows/**",
    "docs/BUILD_ENVIRONMENT.md",
    "docs/DEVELOPER_GUIDE.md",
    "docs/LICENSE_AND_ATTRIBUTION.md",
    "docs/LICENSE_AND_EULA.md",
    "docs/OPERATOR_GUIDE.md",
    "docs/PRIVACY.md",
    "docs/QUICKSTART.md",
    "docs/SECURITY.md",
    "docs/SUPPORT.md",
    "docs/TROUBLESHOOTING.md",
    "docs/UPDATE_AND_ROLLBACK.md",
    "docs/VULNERABILITY_DISCLOSURE.md",
    "licenses/**",
    "src/**"
  ],
  "exclude": [
    "ARTIFACT_MANIFEST.md",
    "docs/exec-plans/**",
    "docs/IMPLEMENTATION_STATUS.md",
    "docs/TRACEABILITY_MATRIX.md",
    "docs/VALIDATION_REPORT.md",
    "docs/TEST_MATRIX.md",
    "docs/RELEASE_CHECKLIST.md",
    "docs/DEMO_AND_SUBMISSION_CHECKLIST.md",
    "docs/DEFCON_SUBMISSION.md",
    "**/x64/**",
    "**/Debug/**",
    "**/Release/**",
    "**/out/**",
    "**/CMakeFiles/**",
    "**/__pycache__/**",
    "**/*.obj",
    "**/*.pdb",
    "**/*.ilk",
    "**/*.sys",
    "**/*.cat"
  ]
}
