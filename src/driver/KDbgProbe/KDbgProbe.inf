[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=08/15/2026,1.0.0.0
CatalogFile=KDbgProbe.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[DefaultInstall.NTamd64]
CopyFiles = DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService = KDBGProbe,0x00000002,KDBGProbe_Service

[KDBGProbe_Service]
DisplayName    = %ServiceDisplayName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\KDbgProbe.sys

[DriverCopyFiles]
KDbgProbe.sys

[SourceDisksFiles]
KDbgProbe.sys = 1

[SourceDisksNames]
1 = %DiskName%,,,

[Strings]
ProviderName="KDBG Project"
ServiceDisplayName="KDBG Probe Fixture Driver"
DiskName="KDBG Probe Driver Installation Media"
