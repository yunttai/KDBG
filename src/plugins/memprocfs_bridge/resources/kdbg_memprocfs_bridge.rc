#include <winver.h>

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "KDBG Project\0"
            VALUE "FileDescription", "KDBG isolated MemProcFS bridge\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "kdbg_memprocfs_bridge\0"
            VALUE "OriginalFilename", "kdbg_memprocfs_bridge.exe\0"
            VALUE "ProductName", "KDBG\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
